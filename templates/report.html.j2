<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AirGuard — отчёт об аудите Wi-Fi</title>
<style>
  :root {
    --bg: #0f1419; --card: #1a2029; --line: #2a333f;
    --text: #e6edf3; --muted: #8b98a5;
    --crit: #f85149; --high: #fb8500; --mid: #e3b341; --low: #3fb950;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 24px;
    font-family: -apple-system, "SF Pro Text", Segoe UI, Roboto, sans-serif;
    background: var(--bg); color: var(--text); line-height: 1.5;
  }
  .wrap { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  .sub { color: var(--muted); font-size: 14px; margin-bottom: 24px; }
  .cards { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .stat {
    flex: 1; min-width: 120px; background: var(--card);
    border: 1px solid var(--line); border-radius: 12px; padding: 16px;
  }
  .stat .n { font-size: 28px; font-weight: 700; }
  .stat .l { font-size: 13px; color: var(--muted); }
  .stat.crit .n { color: var(--crit); }
  .stat.high .n { color: var(--high); }
  .stat.mid .n  { color: var(--mid); }
  .stat.low .n  { color: var(--low); }
  table { width: 100%; border-collapse: collapse; background: var(--card);
    border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); font-size: 14px; }
  th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  tr:last-child td { border-bottom: none; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
  .b-CRITICAL { background: rgba(248,81,73,.15); color: var(--crit); }
  .b-HIGH  { background: rgba(251,133,0,.15); color: var(--high); }
  .b-MEDIUM  { background: rgba(227,179,65,.15); color: var(--mid); }
  .b-LOW   { background: rgba(63,185,80,.15); color: var(--low); }
  h2 { font-size: 18px; margin: 32px 0 12px; }
  .detail { background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 14px 18px; margin-bottom: 10px; }
  .detail .name { font-weight: 600; margin-bottom: 6px; }
  .detail ul { margin: 6px 0; padding-left: 20px; color: var(--muted); font-size: 13px; }
  .foot { color: var(--muted); font-size: 12px; margin-top: 32px; text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <h1>AirGuard — отчёт об аудите Wi-Fi</h1>
  <div class="sub">Сформирован {{ generated }} · пассивный аудит защищённости беспроводных сетей</div>

  <div class="cards">
    <div class="stat"><div class="n">{{ counts.total }}</div><div class="l">всего сетей</div></div>
    <div class="stat crit"><div class="n">{{ counts.get('CRITICAL', 0) }}</div><div class="l">критично</div></div>
    <div class="stat high"><div class="n">{{ counts.get('HIGH', 0) }}</div><div class="l">высокий риск</div></div>
    <div class="stat mid"><div class="n">{{ counts.get('MEDIUM', 0) }}</div><div class="l">средний риск</div></div>
    <div class="stat low"><div class="n">{{ counts.get('LOW', 0) }}</div><div class="l">низкий риск</div></div>
  </div>

  <table>
    <thead>
      <tr><th>SSID</th><th>BSSID</th><th>Шифрование</th><th>Сигнал</th><th>Канал</th><th>Диапазон</th><th>Риск</th></tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>{{ r.ssid }}</td>
        <td>{{ r.bssid }}</td>
        <td>{{ r.security }}</td>
        <td>{{ r.rssi }} dBm</td>
        <td>{{ r.channel }}</td>
        <td>{{ r.band }}</td>
        <td><span class="badge b-{{ r.level }}">{{ r.level }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Детализация и рекомендации</h2>
  {% for r in rows %}
  <div class="detail">
    <div class="name"><span class="badge b-{{ r.level }}">{{ r.level }}</span> &nbsp; {{ r.ssid }}</div>
    {% if r.reasons %}
    <div>Проблемы:</div>
    <ul>{% for reason in r.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>
    {% endif %}
    {% if r.recommendations %}
    <div>Рекомендации:</div>
    <ul>{% for rec in r.recommendations %}<li>{{ rec }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endfor %}

  {% if hosts %}
  <h2>Углублённый аудит своей сети</h2>
  <table>
    <thead><tr><th>Устройство (IP)</th><th>Открытые порты</th></tr></thead>
    <tbody>
      {% for h in hosts %}
      <tr>
        <td>{{ h.ip }}</td>
        <td>{% for port in h.open_ports %}{{ port }}/{{ h.services.get(port, '?') }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <div class="foot">
    AirGuard · инструмент самоаудита беспроводных сетей. Все данные обработаны локально.<br>
    MAC-адреса точек доступа маскированы в целях приватности.
  </div>
</div>
</body>
</html>
